{
  "name": "@obiorachibuike/depguard",
  "version": "0.1.0",
  "description": "Read-only dependency security analysis for JavaScript and TypeScript: CLI and typed API",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "depguard": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:integration": "DEPGUARD_INTEGRATION=1 vitest run tests/integration.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace website",
    "lint": "eslint src tests scripts website --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "typedoc src/index.ts --out api-docs",
    "website:dev": "npm run dev --workspace website",
    "website:build": "npm run build --workspace website",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:package && npm run website:build"
  },
  "workspaces": [
    "website"
  ],
  "dependencies": {
    "@yarnpkg/lockfile": "^1.1.0",
    "commander": "^12.1.0",
    "semver": "^7.7.0",
    "yaml": "^2.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.0",
    "@types/yarnpkg__lockfile": "^1.1.9",
    "eslint": "^9.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Obiorachibuike/DepGuard.git"
  },
  "homepage": "https://github.com/Obiorachibuike/DepGuard#readme",
  "bugs": "https://github.com/Obiorachibuike/DepGuard/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "depguard",
    "dependency-security",
    "vulnerability-scanner",
    "osv",
    "npm",
    "pnpm",
    "yarn",
    "sarif",
    "typescript",
    "cli"
  ]
}
